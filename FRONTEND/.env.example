# Supabase project URL and anon (public) key — both are meant to be exposed to the
# browser; access is enforced by Supabase Row Level Security, not by keeping these secret.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the deployed backend API.
VITE_API_URL=http://localhost:5001/api

# Set to "true" to run the UI entirely against local mock data (lib/mockData.ts),
# without a backend or Supabase project. Optional — defaults to false.
# VITE_USE_MOCK_API=true

# Email address treated as HEAD_ADMIN when the backend sync call fails and the app
# has to guess the role from Supabase auth data alone. Optional — must match the
# backend's HEAD_ADMIN_EMAIL. Defaults to the original faculty account.
# VITE_HEAD_ADMIN_EMAIL=admin@example.com
