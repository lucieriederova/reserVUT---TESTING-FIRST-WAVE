# Postgres connection string used by Prisma at runtime (pooled connection recommended, e.g. Supabase's pgbouncer port).
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Direct (non-pooled) connection, used by `prisma migrate`/`prisma db push`.
DIRECT_URL=postgresql://user:password@host:5432/postgres

# Port the Express server listens on. Railway/most PaaS providers inject this automatically.
PORT=5001

# Base URL of the deployed frontend. Currently unused by the server code but reserved
# for building absolute links (e.g. in emails) — see the migration checklist.
FRONTEND_URL=http://localhost:5173

# Comma-separated list of extra origins allowed by CORS, in addition to the built-in
# localhost defaults and any *.vercel.app preview domain. Optional — omit to use
# the defaults baked into server.ts.
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://staging.example.com

# Email address granted the HEAD_ADMIN role on first login. Optional — defaults to
# the original faculty account used during development.
# HEAD_ADMIN_EMAIL=admin@example.com

# Resend API key for transactional emails (welcome/confirmation/cancellation/preemption).
# Optional — emails are skipped (logged only) when unset.
# RESEND_API_KEY=re_xxxxxxxxxxxx

# "From" address used for outgoing emails. Optional — defaults to Resend's sandbox sender.
# EMAIL_FROM=reserVUT <no-reply@your-domain.com>
